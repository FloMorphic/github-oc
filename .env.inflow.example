# Platform identity for this plugin node — the three values Infra mints when the
# plugin is defined in a space. No GitHub configuration ever lives here; the
# GitHub account is connected centrally in FloMorphic → Connect.
#
# IMPORTANT: this plugin reaches FloMorphic's central services on the
# `flomorphic.svc.oc.*` subjects, so INFRA_CRED must be an OPEN (multi) runtime
# credential — a strict, plugin-scoped credential cannot publish there. Mint one
# from FloMorphic → Settings → MultiPlugin Credential (or the installer's multi
# option).
PLUGIN_ID=aa-bbb-ccc-dddd
INFRA_CRED=LS0tLS1CRUdJTiBOQVRTIFVTRVIgSldULS0t...   # base64 of the .creds blob (OPEN cred)
INFRA_URL=localhost:4222

# Optional — request timeout in SECONDS for the backend proxy round-trip.
# The node defaults to 30s in code (each action is a NATS hop to the backend,
# which then calls the OpenConnector gateway and, for security actions, GitHub).
# Raise it for a slow gateway/network (e.g. 60); it overrides the in-code default.
# REQ_TIMEOUT=60
